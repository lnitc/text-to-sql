# ============================================================================
# TEXT-TO-SQL AGENTIC DATA ANALYST - Environment Configuration
# ============================================================================
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to git
# ============================================================================

# BACKEND CONFIGURATION
# ============================================================================

# OpenAI API Key (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Google Cloud Platform
# Path to GCP service account JSON key file (relative to project root)
GOOGLE_APPLICATION_CREDENTIALS=gcp-key.json
# Your GCP Project ID
GCP_PROJECT_ID=your-gcp-project-id

# FastAPI Configuration
BACKEND_PORT=8000
# Environment: development, staging, production
ENVIRONMENT=development

# BigQuery Configuration
BQ_DATASET_PROJECT=bigquery-public-data
BQ_DATASET_ID=thelook_ecommerce
BQ_QUERY_TIMEOUT_SECONDS=30
BQ_MAX_RESULTS_ROWS=1000

# OpenAI API Rate Limiting & Cost Control
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7
# Monthly spend limit (in USD) - set alert at 50% of this
OPENAI_MONTHLY_BUDGET=15

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================

# API Base URL (use http://backend:8000 for Docker Compose)
# For local development outside Docker: http://localhost:8000
NEXT_PUBLIC_API_URL=http://backend:8000

# Frontend Environment
NEXT_PUBLIC_ENVIRONMENT=development

# ============================================================================
# DOCKER COMPOSE CONFIGURATION
# ============================================================================

# Path to GCP service account key file (used by docker-compose volume mount)
# Example: ./gcp-key.json
GCP_KEY_PATH=./gcp-key.json

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Enable request/response logging
ENABLE_REQUEST_LOGGING=true

# ============================================================================
# OPTIONAL: CACHING & PERFORMANCE
# ============================================================================

# Query result cache TTL (in seconds)
CACHE_TTL_SECONDS=1800

# Maximum query results to cache
CACHE_MAX_RESULTS=10
