# ============================================================================
# TEXT-TO-SQL AGENTIC DATA ANALYST - Environment Configuration
# ============================================================================
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to git
# ============================================================================

# BACKEND CONFIGURATION
# ============================================================================

# OpenAI API Key (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Google Cloud Platform
# Path to GCP service account JSON key file (relative to project root).
# Docker Compose always uses the mounted /secrets/gcp-key.json instead.
GOOGLE_APPLICATION_CREDENTIALS=gcp-key.json
# Your GCP Project ID
GCP_PROJECT_ID=your-gcp-project-id

# Text-to-SQL pipeline used when a request doesn't choose one:
#   simple - one LLM call per question (fast, cheap; default)
#   crew   - CrewAI multi-agent flow: planner, SQL developer and analyst agents
#            (slower, adds written insights and follow-up questions)
# The UI's "Multi-agent analysis" toggle overrides this per request.
PIPELINE_MODE=simple

# FastAPI Configuration
BACKEND_PORT=8000
# Environment: development, staging, production
ENVIRONMENT=development

# BigQuery Configuration (the queried dataset is defined in
# backend/schemas/bigquery_schema.py)
BQ_QUERY_TIMEOUT_SECONDS=30
BQ_MAX_RESULTS_ROWS=1000
# Per-query scan limit in bytes (cost guard, default 10 GB)
BQ_MAX_BYTES_BILLED=10737418240

# OpenAI model and response size. Set spend limits and alerts in your
# OpenAI account's billing settings; the app does not track spending.
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2000

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================

# API Base URL. The browser calls this directly, so use a URL reachable from
# the host (http://localhost:8000) both with and without Docker Compose.
# NEXT_PUBLIC_* values are baked in at build time (npm run build).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Frontend Environment
NEXT_PUBLIC_ENVIRONMENT=development

# ============================================================================
# DOCKER COMPOSE CONFIGURATION
# ============================================================================

# Path to GCP service account key file (used by docker-compose volume mount)
# Example: ./gcp-key.json
GCP_KEY_PATH=./gcp-key.json

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Enable request/response logging
ENABLE_REQUEST_LOGGING=true
